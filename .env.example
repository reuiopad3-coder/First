# ==============================================================================
# Telegram Stars Bot — Файл конфигурации (.env)
# Скопируйте этот файл в .env (например: cp .env.example .env) и укажите ваши данные
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot (ОБЯЗАТЕЛЬНО)
# ------------------------------------------------------------------------------
# Токен бота. Получите его в Telegram у официального бота @BotFather:
# 1) Напишите /newbot
# 2) Задайте имя и username бота
# 3) Скопируйте полученный токен сюда:
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Ваш Telegram ID (число). Узнать свой ID можно через бота @userinfobot или @myidbot.
# Можно указать несколько ID через запятую, например: 123456789,987654321
ADMIN_IDS=123456789

# ------------------------------------------------------------------------------
# 2. База данных (SQLAlchemy 2.0 Async)
# ------------------------------------------------------------------------------
# Локальный запуск (по умолчанию):
DATABASE_URL=sqlite+aiosqlite:///bot.db
# Для запуска в Docker (с сохранением в том data/):
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Для перехода на PostgreSQL (например, на Railway или выделенном сервере):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/stars_bot

# ------------------------------------------------------------------------------
# 3. Платёжная система CryptoBot (Crypto Pay API)
# ------------------------------------------------------------------------------
# Для тестирования рекомендуется тестовая сеть (Testnet):
# 1) Откройте в Telegram тестового бота: @CryptoTestnetBot
# 2) Нажмите /pay -> Create App -> скопируйте API Token в CRYPTOBOT_TOKEN
# 3) Оставьте CRYPTOBOT_NETWORK=testnet (позволяет тестировать оплату тестовыми USDT)
#
# Для боевого запуска:
# 1) Откройте @CryptoBot -> /pay -> Create App
# 2) Укажите полученный токен и переключите CRYPTOBOT_NETWORK=main
CRYPTOBOT_TOKEN=your_cryptobot_api_token_here
CRYPTOBOT_NETWORK=testnet

# ------------------------------------------------------------------------------
# 4. Выдача Telegram Stars (Провайдер)
# ------------------------------------------------------------------------------
# 'mock'     - тестовая эмуляция выдачи (без реальных затрат, звёзды логируются)
# 'fragment' - интеграция с Fragment (в разработке)
STARS_PROVIDER=mock

# ------------------------------------------------------------------------------
# 5. Ценообразование в USDT
# ------------------------------------------------------------------------------
# Базовая себестоимость 1 звезды в USDT (например, 0.0180 USDT за 1 звезду)
STAR_DEFAULT_BASE_PRICE=0.0180

# Процент наценки (например, 15.0 = +15% к базовой стоимости)
STAR_DEFAULT_MARKUP_PERCENT=15.0

# Лимиты покупки звёзд за один заказ
MIN_STARS=50
MAX_STARS=10000

# ------------------------------------------------------------------------------
# 6. Таймауты и фоновая проверка
# ------------------------------------------------------------------------------
# Время жизни счёта на оплату в минутах (по истечении счёт считается просроченным)
PAYMENT_EXPIRE_MINUTES=15

# Интервал проверки неоплаченных счетов воркером (в секундах)
PAYMENT_CHECK_INTERVAL_SECONDS=10

# ------------------------------------------------------------------------------
# 7. Поддержка и отзывы (для пользовательского меню)
# ------------------------------------------------------------------------------
SUPPORT_USERNAME=@your_support_username
REVIEWS_URL=https://t.me/your_reviews_channel
